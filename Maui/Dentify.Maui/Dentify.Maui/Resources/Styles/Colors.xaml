<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand: deep petrol with a light teal for dark mode -->
    <Color x:Key="Primary">#0B5563</Color>
    <Color x:Key="PrimaryDark">#5FC4CF</Color>
    <Color x:Key="PrimaryDarkText">#0B1A22</Color>
    <Color x:Key="Secondary">#DCEEF0</Color>
    <Color x:Key="SecondaryDarkText">#5FC4CF</Color>
    <Color x:Key="Tertiary">#073B45</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F1B2D</Color>
    <Color x:Key="OffBlack">#10171D</Color>

    <Color x:Key="Gray100">#E4E8EB</Color>
    <Color x:Key="Gray200">#C9D0D5</Color>
    <Color x:Key="Gray300">#A9B3BA</Color>
    <Color x:Key="Gray400">#8B969E</Color>
    <Color x:Key="Gray500">#66727B</Color>
    <Color x:Key="Gray600">#3D4850</Color>
    <Color x:Key="Gray900">#1E262C</Color>
    <Color x:Key="Gray950">#141A1F</Color>

    <!-- Surfaces -->
    <Color x:Key="SurfaceLight">#F3F6F7</Color>
    <Color x:Key="SurfaceDark">#0C1217</Color>
    <Color x:Key="CardLight">White</Color>
    <Color x:Key="CardDark">#161F26</Color>
    <Color x:Key="LineLight">#E1E6E9</Color>
    <Color x:Key="LineDark">#24303A</Color>
    <Color x:Key="InkLight">#0F1B2D</Color>
    <Color x:Key="InkDark">#EEF3F5</Color>
    <Color x:Key="MutedLight">#5E6A73</Color>
    <Color x:Key="MutedDark">#9AA6AE</Color>

    <!-- Belgian license plate: burgundy on white, with the blue EU band -->
    <Color x:Key="PlateText">#A3172F</Color>
    <Color x:Key="PlateBackground">White</Color>
    <Color x:Key="PlateEuBand">#003399</Color>

    <!-- Icon tiles, segmented controls and the AI accent -->
    <Color x:Key="TileLight">#DDEFF1</Color>
    <Color x:Key="TileDark">#14303A</Color>
    <Color x:Key="SegmentTrackLight">#E4EAED</Color>
    <Color x:Key="SegmentTrackDark">#18222A</Color>
    <Color x:Key="SegmentSelectedDark">#244651</Color>
    <Color x:Key="AiAccent">#6D5BD0</Color>
    <Color x:Key="AiAccentDark">#A99BF5</Color>
    <Color x:Key="AiBackgroundLight">#F1EEFD</Color>
    <Color x:Key="AiBackgroundDark">#1E1B33</Color>
    <Color x:Key="HeroStart">#0B5563</Color>
    <Color x:Key="HeroEnd">#0F7A86</Color>

    <!-- Status and damage severity -->
    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="SuccessBackground">#DCF5E4</Color>
    <Color x:Key="SeverityMinor">#A86B00</Color>
    <Color x:Key="SeverityMinorBackground">#FFF1CC</Color>
    <Color x:Key="SeverityModerate">#C2530A</Color>
    <Color x:Key="SeverityModerateBackground">#FFE4CF</Color>
    <Color x:Key="SeveritySevere">#C4231A</Color>
    <Color x:Key="SeveritySevereBackground">#FDDEDB</Color>
    <Color x:Key="Error">#C4231A</Color>
    <Color x:Key="ErrorBackground">#FDE8E6</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
