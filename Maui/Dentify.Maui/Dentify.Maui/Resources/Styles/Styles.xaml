    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- Dentify styles -->

    <!-- Text -->
    <Style TargetType="Label" x:Key="PageTitle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="JakartaExtraBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="CharacterSpacing" Value="-0.6" />
    </Style>

    <Style TargetType="Label" x:Key="SectionTitle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
    </Style>

    <Style TargetType="Label" x:Key="CardTitle">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="JakartaRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Label" x:Key="MutedText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontFamily" Value="JakartaRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Small uppercase label above a value or a section -->
    <Style TargetType="Label" x:Key="Caption">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.4" />
    </Style>

    <Style TargetType="Label" x:Key="ErrorText">
        <Setter Property="TextColor" Value="{StaticResource Error}" />
        <Setter Property="FontFamily" Value="JakartaMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Surfaces: soft shadow in light mode, a fine line in dark mode where shadows do not show -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#EAEFF1, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Shadow Brush="#0B3A44" Opacity="0.07" Radius="18" Offset="0,6" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ErrorCard">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}" />
        <Setter Property="Stroke" Value="#F5C2BD" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Petrol gradient for the main card of a page -->
    <Style TargetType="Border" x:Key="HeroCard">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource HeroStart}" Offset="0" />
                <GradientStop Color="{StaticResource HeroEnd}" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#0B5563" Opacity="0.28" Radius="22" Offset="0,10" />
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="HeroCaption">
        <Setter Property="TextColor" Value="#B9E3E8" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.4" />
    </Style>

    <Style TargetType="Label" x:Key="HeroValue">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="JakartaSemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- AI output (report, AI check) gets a violet accent, so it reads apart from measured data -->
    <Style TargetType="Border" x:Key="AiCard">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AiBackgroundLight}, Dark={StaticResource AiBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0DAFB, Dark=#2E2950}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style TargetType="Label" x:Key="AiCaption" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AiAccent}, Dark={StaticResource AiAccentDark}}" />
    </Style>

    <!-- Square tile behind an icon -->
    <Style TargetType="Border" x:Key="IconTile">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileLight}, Dark={StaticResource TileDark}}" />
    </Style>

    <!-- Round icon button in a page header -->
    <Style TargetType="Border" x:Key="HeaderButton">
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E4EAED, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 23" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Belgian license plate: white, burgundy letters, blue EU band with a B -->
    <Style TargetType="Border" x:Key="PlateChip">
        <Setter Property="BackgroundColor" Value="{StaticResource PlateBackground}" />
        <Setter Property="Stroke" Value="{StaticResource PlateText}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Border" x:Key="PlateBand">
        <Setter Property="BackgroundColor" Value="{StaticResource PlateEuBand}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="5,0" />
    </Style>

    <Style TargetType="Label" x:Key="PlateBandText">
        <Setter Property="Text" Value="B" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style TargetType="Label" x:Key="PlateText">
        <Setter Property="TextColor" Value="{StaticResource PlateText}" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="Margin" Value="8,4,10,4" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="Badge">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileLight}, Dark={StaticResource TileDark}}" />
    </Style>

    <Style TargetType="Label" x:Key="BadgeText">
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="JakartaBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Shadow">
            <Shadow Brush="#0B5563" Opacity="0.25" Radius="16" Offset="0,8" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontFamily" Value="JakartaSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileLight}, Dark={StaticResource TileDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="JakartaSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Segmented control: a track with buttons, the page marks the selected one with a DataTrigger -->
    <Style TargetType="Border" x:Key="SegmentBar">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SegmentTrackLight}, Dark={StaticResource SegmentTrackDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="Button" x:Key="SegmentButton">
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="JakartaSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Pages keep a readable column on wide windows (Windows, tablets); phones are narrower anyway -->
    <x:Double x:Key="ContentMaxWidth">720</x:Double>

    <!-- Rounded field around an Entry -->
    <Style TargetType="Border" x:Key="FormField">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#DDE4E8, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,2" />
    </Style>

    <Style TargetType="Entry" x:Key="FormEntry">
        <Setter Property="FontFamily" Value="JakartaMedium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
    </Style>

</ResourceDictionary>
