<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Dentify.Maui.ViewModels"
             xmlns:models="clr-namespace:Dentify.Maui.Models"
             x:Class="Dentify.Maui.Views.VehicleDetailPage"
             x:DataType="viewModels:VehicleDetailViewModel"
             Title="Vehicle">

    <!-- In the nav bar: on Windows a button in the CollectionView header ignores mouse clicks -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit"
                     Command="{Binding EditVehicleCommand}"
                     SemanticProperties.Description="Edit vehicle" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="{StaticResource ContentMaxWidth}">
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Inspections}"
                            SelectionMode="None"
                            Margin="20,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <!-- Vehicle card and section title -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="16" Padding="0,16,0,6">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource PlateChip}"
                                            Padding="14,6"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Vehicle.LicensePlate}"
                                               Style="{StaticResource PlateText}"
                                               FontSize="20" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource Badge}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Vehicle.Type}" Style="{StaticResource BadgeText}" />
                                    </Border>                                </Grid>

                                <Label Style="{StaticResource PageTitle}"
                                       FontSize="24"
                                       SemanticProperties.HeadingLevel="Level1">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Vehicle.Brand" />
                                            <Binding Path="Vehicle.Model" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <BoxView HeightRequest="1"
                                         Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                                <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasLoaded}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="HISTORY" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding InspectionCountText}" Style="{StaticResource BodyText}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="LAST CHECK" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding LastInspectionText}" Style="{StaticResource BodyText}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding ErrorMessage}"
                                       Style="{StaticResource ErrorText}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Retry"
                                        Command="{Binding RefreshCommand}"
                                        HeightRequest="40"
                                        Padding="16,0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Label Text="Inspection history"
                               Style="{StaticResource SectionTitle}"
                               SemanticProperties.HeadingLevel="Level2" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- Loading and empty states -->
                <CollectionView.EmptyView>
                    <Grid Padding="0,24">
                        <VerticalStackLayout IsVisible="{Binding ShowFirstLoad}" Spacing="12">
                            <ActivityIndicator IsRunning="{Binding ShowFirstLoad}" />
                            <Label Text="Loading inspections…"
                                   Style="{StaticResource MutedText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Border Style="{StaticResource Card}"
                                IsVisible="{Binding ShowEmptyState}"
                                Padding="20">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="No inspections yet"
                                       Style="{StaticResource CardTitle}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Start an inspection at departure or return to record the condition of this vehicle."
                                       Style="{StaticResource MutedText}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="20" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InspectionListItem">
                        <Border Style="{StaticResource Card}"
                                Padding="12"
                                SemanticProperties.Hint="Opens the result of this inspection">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenInspectionCommand, Source={RelativeSource AncestorType={x:Type viewModels:VehicleDetailViewModel}}, x:DataType=viewModels:VehicleDetailViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="14">

                                <!-- Cover photo, or a placeholder while loading or without photos -->
                                <Border WidthRequest="72"
                                        HeightRequest="72"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource LineDark}}">
                                    <Grid>
                                        <Label Text="{Binding TypeText}"
                                               Style="{StaticResource Caption}"
                                               FontSize="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding HasCoverPhoto, Converter={StaticResource InverseBoolConverter}}" />
                                        <Image Source="{Binding CoverPhoto}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasCoverPhoto}"
                                               SemanticProperties.Description="Cover photo of the inspection" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding TypeText}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Inspection.Date, StringFormat='{0:dd MMM yyyy · HH:mm}'}"
                                           Style="{StaticResource MutedText}" />
                                    <Label Text="{Binding Inspection.InspectorName}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Damage status -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource Badge}"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="NoDamage">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Damage">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SeverityModerateBackground}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding StatusText}" Style="{StaticResource BadgeText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="NoDamage">
                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Damage">
                                                <Setter Property="TextColor" Value="{StaticResource SeverityModerate}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="New inspection"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding StartInspectionCommand}"
                Margin="20,4,20,16"
                SemanticProperties.Hint="Starts a departure or return inspection of this vehicle" />
    </Grid>

</ContentPage>
