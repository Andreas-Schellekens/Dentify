<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Dentify.Maui.ViewModels"
             xmlns:models="clr-namespace:Dentify.Contracts.Models;assembly=Dentify.Contracts"
             x:Class="Dentify.Maui.Views.VehicleListPage"
             x:DataType="viewModels:VehicleListViewModel"
             Shell.NavBarIsVisible="{OnPlatform Default=False, WinUI=True}"
             Title="{OnPlatform Default=Vehicles, WinUI=''}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          MaximumWidthRequest="{StaticResource ContentMaxWidth}"
          Padding="20,18,20,0"
          RowSpacing="14">

        <!-- Header: brand mark, title and actions -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Border Style="{StaticResource HeroCard}"
                    Padding="8"
                    WidthRequest="46"
                    HeightRequest="46"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0B5563" Opacity="0.3" Radius="12" Offset="0,5" />
                </Border.Shadow>
                <Image Source="ic_logo.png" SemanticProperties.Description="Dentify" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="DENTIFY"
                       Style="{StaticResource Caption}"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label Text="Vehicles"
                       Style="{StaticResource PageTitle}"
                       FontSize="26"
                       SemanticProperties.HeadingLevel="Level1" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource HeaderButton}">
                <ImageButton Source="ic_add.png"
                             Command="{Binding AddVehicleCommand}"
                             Padding="11"
                             BackgroundColor="Transparent"
                             SemanticProperties.Description="Add vehicle" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource HeaderButton}">
                <ImageButton Source="ic_settings.png"
                             Command="{Binding OpenSettingsCommand}"
                             Padding="11"
                             BackgroundColor="Transparent"
                             SemanticProperties.Description="Settings" />
            </Border>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1"
                Style="{StaticResource FormField}"
                Padding="4,0"
                StrokeShape="RoundRectangle 16">
            <SearchBar Text="{Binding SearchQuery}"
                       Placeholder="Search by plate, brand or model"
                       FontFamily="JakartaMedium"
                       SemanticProperties.Description="Search vehicles" />
        </Border>

        <!-- Error state -->
        <Border Grid.Row="2"
                Style="{StaticResource ErrorCard}"
                IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding RefreshCommand}"
                        HeightRequest="40"
                        Padding="16,0"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Vehicle list -->
        <RefreshView Grid.Row="3"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Vehicles}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="2" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:VehicleListDto">
                        <Border Style="{StaticResource Card}"
                                Padding="14"
                                Margin="0,0,0,2"
                                SemanticProperties.Hint="Opens the vehicle and its inspections">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SelectVehicleCommand, Source={RelativeSource AncestorType={x:Type viewModels:VehicleListViewModel}}, x:DataType=viewModels:VehicleListViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                <Border Style="{StaticResource IconTile}" VerticalOptions="Center">
                                    <Image Source="ic_car.png" WidthRequest="26" HeightRequest="26">
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image" Binding="{Binding Type}" Value="Van">
                                                <Setter Property="Source" Value="ic_van.png" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Style="{StaticResource CardTitle}"
                                           LineBreakMode="TailTruncation">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Brand" />
                                                <Binding Path="Model" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Type}" Style="{StaticResource MutedText}" FontSize="13" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        Style="{StaticResource PlateChip}"
                                        VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,Auto">
                                        <Border Style="{StaticResource PlateBand}">
                                            <Label Style="{StaticResource PlateBandText}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding LicensePlate}" Style="{StaticResource PlateText}" FontSize="14" />
                                    </Grid>
                                </Border>
                                <Image Grid.Column="3"
                                       Source="ic_chevron.png"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       Margin="2,0,0,0"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- First load -->
        <VerticalStackLayout Grid.Row="3"
                             IsVisible="{Binding ShowFirstLoad}"
                             VerticalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding ShowFirstLoad}" />
            <Label Text="Loading vehicles…"
                   Style="{StaticResource MutedText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="3"
                             IsVisible="{Binding ShowEmptyState}"
                             InputTransparent="True"
                             VerticalOptions="Center"
                             Spacing="10"
                             Padding="24,0">
            <Border Style="{StaticResource IconTile}"
                    WidthRequest="64"
                    HeightRequest="64"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Center">
                <Image Source="ic_car.png" WidthRequest="32" HeightRequest="32" />
            </Border>
            <Label Text="{Binding EmptyStateTitle}"
                   Style="{StaticResource SectionTitle}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Check the spelling, pull down to refresh, or add the vehicle with the + button."
                   Style="{StaticResource MutedText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Main action -->
        <Button Grid.Row="4"
                Text="Scan license plate"
                Style="{StaticResource PrimaryButton}"
                ImageSource="{AppThemeBinding Light=ic_scan_light.png, Dark=ic_scan_dark.png}"
                ContentLayout="Left,10"
                Command="{Binding ScanPlateCommand}"
                Margin="0,4,0,18"
                SemanticProperties.Hint="Takes a photo of a license plate to find the vehicle" />
    </Grid>

</ContentPage>
