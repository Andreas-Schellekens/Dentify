<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Dentify.Maui.ViewModels"
             x:Class="Dentify.Maui.Views.PlateScanPage"
             x:DataType="viewModels:PlateScanViewModel"
             Title="Scan plate">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18" MaximumWidthRequest="{StaticResource ContentMaxWidth}">

            <!-- Intro -->
            <Border Style="{StaticResource Card}" Padding="24" IsVisible="{Binding ShowIntro}">
                <VerticalStackLayout Spacing="16">
                    <Border Style="{StaticResource PlateChip}" HorizontalOptions="Center" Opacity="0.85">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Border Style="{StaticResource PlateBand}">
                                <Label Style="{StaticResource PlateBandText}" FontSize="14" Margin="3,0,3,6" />
                            </Border>
                            <Label Grid.Column="1" Text="1-ABC-123" Style="{StaticResource PlateText}" FontSize="28" Margin="12,8,16,8" />
                        </Grid>
                    </Border>
                    <Label Text="Scan a license plate"
                           Style="{StaticResource SectionTitle}"
                           FontSize="20"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Take the photo straight on, close enough that the plate fills about a third of the picture. Dentify reads it and finds the vehicle."
                           Style="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Photo preview, with an overlay while the API reads the plate -->
            <Border IsVisible="{Binding HasPhoto}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="240"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardDark}}">
                <Grid>
                    <Image Source="{Binding Photo}"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Photo of the license plate" />
                    <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#990F1B2D">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" />
                            <Label Text="Reading the plate…"
                                   TextColor="White"
                                   FontFamily="JakartaSemiBold"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Result: vehicle found -->
            <Border Style="{StaticResource Card}"
                    Stroke="{StaticResource Success}"
                    StrokeThickness="2"
                    Padding="22"
                    IsVisible="{Binding IsMatch}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="VEHICLE FOUND" Style="{StaticResource Caption}" TextColor="{StaticResource Success}" />
                    <Border Style="{StaticResource PlateChip}" HorizontalOptions="Start">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Border Style="{StaticResource PlateBand}">
                                <Label Style="{StaticResource PlateBandText}" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Result.Vehicle.LicensePlate}" Style="{StaticResource PlateText}" FontSize="20" Margin="10,6,12,6" />
                        </Grid>
                    </Border>
                    <Label Style="{StaticResource PageTitle}" FontSize="22">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Result.Vehicle.Brand" />
                                <Binding Path="Result.Vehicle.Model" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label Text="{Binding Result.Vehicle.Type}" Style="{StaticResource MutedText}" />
                    <Button Text="Start inspection"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartInspectionCommand}"
                            Margin="0,6,0,0" />
                    <Button Text="Open vehicle"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenVehicleCommand}" />
                    <Button Text="Scan again"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ScanAgainCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Result: plate read, but not in the fleet -->
            <Border Style="{StaticResource Card}"
                    Stroke="{StaticResource SeverityMinor}"
                    StrokeThickness="2"
                    Padding="22"
                    IsVisible="{Binding IsUnknownPlate}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="NOT IN THE FLEET" Style="{StaticResource Caption}" TextColor="{StaticResource SeverityMinor}" />
                    <Border Style="{StaticResource PlateChip}" HorizontalOptions="Start">
                        <Grid ColumnDefinitions="Auto,Auto">
                            <Border Style="{StaticResource PlateBand}">
                                <Label Style="{StaticResource PlateBandText}" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Result.RecognizedPlate}" Style="{StaticResource PlateText}" FontSize="20" Margin="10,6,12,6" />
                        </Grid>
                    </Border>
                    <Label Text="No vehicle has this plate. Add it as a new vehicle, or pick it from the list if the plate was misread."
                           Style="{StaticResource BodyText}" />
                    <Button Text="Add this vehicle"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddScannedVehicleCommand}"
                            Margin="0,6,0,0"
                            SemanticProperties.Hint="Opens the add vehicle form with this plate filled in" />
                    <Button Text="Choose from the list"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ChooseFromListCommand}" />
                    <Button Text="Scan again"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ScanAgainCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Result: no plate on the photo -->
            <Border Style="{StaticResource Card}"
                    Padding="20"
                    IsVisible="{Binding IsNoPlate}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="NO PLATE FOUND" Style="{StaticResource Caption}" />
                    <Label Text="Dentify could not read a license plate on this photo. Get a bit closer, hold the phone straight and avoid reflections."
                           Style="{StaticResource BodyText}" />
                    <Button Text="Scan again"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanAgainCommand}"
                            Margin="0,6,0,0" />
                    <Button Text="Choose from the list"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ChooseFromListCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Capture -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowCaptureButtons}">
                <Button Text="Take photo"
                        Style="{StaticResource PrimaryButton}"
                        ImageSource="{AppThemeBinding Light=ic_scan_light.png, Dark=ic_scan_dark.png}"
                        ContentLayout="Left,10"
                        Command="{Binding TakePhotoCommand}"
                        IsVisible="{Binding IsCaptureSupported}"
                        IsEnabled="{Binding IsNotBusy}" />
                <Button Text="Choose from gallery"
                        Style="{StaticResource SecondaryButton}"
                        ImageSource="ic_gallery.png"
                        ContentLayout="Left,8"
                        Command="{Binding PickPhotoCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
