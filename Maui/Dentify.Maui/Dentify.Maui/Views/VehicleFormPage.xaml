<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Dentify.Maui.ViewModels"
             x:Class="Dentify.Maui.Views.VehicleFormPage"
             x:DataType="viewModels:VehicleFormViewModel"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="*,Auto" MaximumWidthRequest="{StaticResource ContentMaxWidth}">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,8" Spacing="22">

                <!-- License plate: scan it, or type it -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="License plate" Style="{StaticResource SectionTitle}" />
                    <!-- A plain field with the EU band in front: a white plate-styled Entry rendered its text invisible on Windows -->
                    <Border Style="{StaticResource FormField}" Padding="0,0,14,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource PlateBand}" Padding="9,0">
                                <Label Style="{StaticResource PlateBandText}" FontSize="13" Margin="0,0,0,6" />
                            </Border>
                        <Entry Grid.Column="1"
                               Text="{Binding LicensePlate}"
                               Style="{StaticResource FormEntry}"
                               Placeholder="1-ABC-123"
                               MaxLength="20"
                               FontFamily="JakartaSemiBold"
                               IsEnabled="{Binding IsNotBusy}"
                               SemanticProperties.Description="License plate" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Scan plate"
                                Style="{StaticResource SecondaryButton}"
                                ImageSource="ic_camera.png"
                                ContentLayout="Left,8"
                                Command="{Binding ScanPlateWithCameraCommand}"
                                IsVisible="{Binding IsCaptureSupported}"
                                IsEnabled="{Binding IsNotBusy}"
                                SemanticProperties.Hint="Takes a photo of the plate and fills it in" />
                        <Button Grid.Column="1"
                                Text="From gallery"
                                Style="{StaticResource SecondaryButton}"
                                ImageSource="ic_gallery.png"
                                ContentLayout="Left,8"
                                Command="{Binding ScanPlateFromGalleryCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                SemanticProperties.Hint="Reads the plate from a photo and fills it in">
                            <!-- Full width when there is no camera button (Windows) -->
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCaptureSupported}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsScanning}">
                        <ActivityIndicator IsRunning="{Binding IsScanning}" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Reading the plate…" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ScanMessage}"
                           Style="{StaticResource MutedText}"
                           TextColor="{StaticResource Success}"
                           IsVisible="{Binding HasScanMessage}" />
                </VerticalStackLayout>

                <!-- Brand and model -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Brand" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource FormField}">
                        <Entry Text="{Binding Brand}"
                               Style="{StaticResource FormEntry}"
                               Placeholder="e.g. Renault"
                               MaxLength="50"
                               IsEnabled="{Binding IsNotBusy}"
                               SemanticProperties.Description="Brand" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Model" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource FormField}">
                        <Entry Text="{Binding Model}"
                               Style="{StaticResource FormEntry}"
                               Placeholder="e.g. Clio"
                               MaxLength="50"
                               IsEnabled="{Binding IsNotBusy}"
                               SemanticProperties.Description="Model" />
                    </Border>
                </VerticalStackLayout>

                <!-- Type -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Type" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource SegmentBar}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button Text="Car"
                                Style="{StaticResource SegmentButton}"
                                ImageSource="ic_car.png"
                                ContentLayout="Left,8"
                                Command="{Binding SelectCarCommand}"
                                IsEnabled="{Binding IsNotBusy}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsCar}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SegmentSelectedDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="Van"
                                Style="{StaticResource SegmentButton}"
                                ImageSource="ic_van.png"
                                ContentLayout="Left,8"
                                Command="{Binding SelectVanCommand}"
                                IsEnabled="{Binding IsNotBusy}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsVan}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SegmentSelectedDark}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save -->
        <Button Grid.Row="1"
                Text="{Binding SaveButtonText}"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding SaveCommand}"
                Margin="20,8,20,18" />
    </Grid>

</ContentPage>
